<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>

        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#FFFFFF</item>

        <item name="android:background">@drawable/key_background</item>

        <!-- ✅ Single margin system -->
        <item name="android:layout_margin">2dp</item>

        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ActionKeyStyle" parent="@style/KeyStyle">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SpaceKeyStyle" parent="@style/KeyStyle">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TopRowFixedButtonStyle">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="TopRowActionStyle" parent="@style/KeyStyle">
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SuggestionPlaceholderStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#90A4AE</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/key_background</item>
    </style>

    <style name="EmojiCategoryStyle" parent="@style/KeyStyle">
        <item name="android:layout_height">30dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="EmojiPanelKeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:layout_margin">2dp</item>
    </style>
</resources>
